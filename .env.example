# Copiar este archivo como ".env" y rellenar las dos claves.
# El archivo ".env" está en el .gitignore y no se sube al repositorio.

# abuse.ch (ThreatFox, URLhaus, MalwareBazaar): gratuita en https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# AlienVault OTX: gratuita, en la página Settings de la cuenta en https://otx.alienvault.com
OTX_API_KEY=
